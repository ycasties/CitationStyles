<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0.2"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>JMIR mHealth and uHealth Custom</title>
    <title-short>JMIR Custom</title-short>
    <id>https://www.zotero.org/styles/jmir-mhealth-custom</id>
    <link href="https://mhealth.jmir.org/" rel="documentation"/>
    <updated>2026-09-29T00:00:00+00:00</updated>
  </info>

  <citation>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="7"
                et-al-use-first="6"
                hanging-indent="true">

    <layout>

      <text variable="citation-number"
            suffix=". "/>

      <names variable="author"
             suffix=". ">

        <name name-as-sort-order="all"
              sort-separator=" "
              initialize-with=""
              delimiter=", "
              delimiter-precedes-et-al="always"/>

        <et-al/>

      </names>

      <text variable="title"
            text-case="sentence"
            suffix=". "/>

      <text variable="container-title"
            suffix=". "/>

      <date variable="issued"
            suffix=";">

        <date-part name="month"
                   form="short"/>

        <date-part name="year"
                   prefix=" "/>

      </date>

      <text variable="volume"/>

      <text variable="issue"
            prefix="("
            suffix=")"/>

      <text variable="page"
            prefix=":"/>

      <text variable="DOI"
            prefix=". [doi: "
            suffix="]"/>

      <text variable="PMID"
            prefix=" [Medline: "
            suffix="]"/>

    </layout>

  </bibliography>

</style>
